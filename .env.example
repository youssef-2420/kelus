# Optional analytics (GA4 measurement ID). Leave blank to skip loading GA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional remote waitlist endpoint (Formspree / Getform / custom). Leave blank for on-device capture only.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Optional Supabase auth (sign-in stays hidden when unset).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
