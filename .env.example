# eBay Production OAuth credentials from Developer Program > Application Keys.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Kelus currently supports the United States marketplace only.
EBAY_MARKETPLACE_ID=EBAY_US

# Optional operational tuning.
EBAY_CACHE_TTL_SECONDS=60
EBAY_REQUEST_TIMEOUT_MS=8000

# Supabase Project Settings > API. The publishable key is safe for browser use;
# never add a service_role or secret key to a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key used by the scheduled alert monitor. Never expose it
# through a NEXT_PUBLIC variable or commit a real value.
SUPABASE_SECRET_KEY=

# Shared only between the Supabase Cron job and the server alert endpoint.
ALERT_MONITOR_SECRET=

# Server-only transactional price-alert email configuration.
RESEND_API_KEY=
ALERT_EMAIL_FROM=Kelus Alerts <alerts@updates.kelus.me>
