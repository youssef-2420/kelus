# Optional analytics (GA4 measurement ID). Leave blank to skip loading GA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional remote waitlist endpoint (Formspree / Getform / custom). Leave blank for on-device capture only.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Optional override for the questions inbox endpoint (Formspree / Getform / custom).
# If blank, Kelus posts to FormSubmit → hello@kelus.me (https://formsubmit.co/ajax/hello@kelus.me).
# FormSubmit requires a one-time inbox activation email the first time a form is used.
# Until that link is confirmed, submissions stay on-device (Questions page backup CSV) and
# success is reported as local delivery — not as a silent drop.
# Prefer Formspree/Getform in production if you want an already-activated endpoint without that step.
NEXT_PUBLIC_QUESTIONS_ENDPOINT=

# Optional Supabase auth (sign-in stays hidden when unset).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Stripe Payment Link for Exam Pass checkout. Leave blank to keep waitlist CTA.
# Must match the name used in GitHub Actions / Cloudflare build secrets.
NEXT_PUBLIC_EXAM_PASS_PAYMENT_LINK=
